+                    local names = {}
+                    for name in pairs(source) do
+                        if type(name) ~= "string" or #name < 1 or #name > 128 then return nil end
+                        names[#names+1] = name
+                        if #names > limit then return nil end
+                    end
+                    table.sort(names)
